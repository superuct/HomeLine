{
  "targets": {
    "SMSNotificationService": {
      "platform": "iOS",
      "info": {
        "properties": {
          "SMSBadgeKeychainGroup": "$(AppIdentifierPrefix)org.example.homeline.sms-badge",
          "CFBundleDisplayName": "\u4fe1\u606f\u901a\u77e5",
          "CFBundleShortVersionString": "$(MARKETING_VERSION)",
          "CFBundleVersion": "$(CURRENT_PROJECT_VERSION)",
          "NSContactsUsageDescription": "\u5728\u4fe1\u606f\u901a\u77e5\u4e2d\u663e\u793a\u901a\u8baf\u5f55\u91cc\u7684\u53d1\u4ef6\u4eba\u59d3\u540d\u3002",
          "NSExtension": {
            "NSExtensionPointIdentifier": "com.apple.usernotifications.service",
            "NSExtensionPrincipalClass": "$(PRODUCT_MODULE_NAME).NotificationService"
          }
        },
        "path": "build/org.example.homeline.notifications.webrtc.plist"
      },
      "type": "app-extension",
      "settings": {
        "base": {
          "PRODUCT_BUNDLE_IDENTIFIER": "org.example.homeline.notifications",
          "APPLICATION_EXTENSION_API_ONLY": true,
          "CODE_SIGN_ENTITLEMENTS": "ios/NotificationService/NotificationService.entitlements"
        }
      },
      "sources": [
        {
          "path": "ios/NotificationService",
          "excludes": [
            "Info.plist",
            "NotificationService.entitlements"
          ]
        },
        "ios/Shared"
      ]
    },
    "HomeLineNavigationUITests": {
      "dependencies": [
        {
          "target": "HomeLine"
        }
      ],
      "sources": [
        "ios/UITests"
      ],
      "type": "bundle.ui-testing",
      "settings": {
        "base": {
          "PRODUCT_BUNDLE_IDENTIFIER": "org.example.homeline.navigationtests",
          "GENERATE_INFOPLIST_FILE": true,
          "TEST_TARGET_NAME": "HomeLine"
        }
      },
      "platform": "iOS"
    },
    "HomeLine": {
      "type": "application",
      "dependencies": [
        {
          "target": "SMSNotificationService"
        },
        {
          "product": "WebRTC",
          "package": "WebRTC"
        }
      ],
      "sources": [
        {
          "path": "ios/Sources",
          "excludes": [
            "VoiceAudio.swift"
          ]
        },
        "ios/Shared",
        "ios/Assets.xcassets"
      ],
      "settings": {
        "base": {
          "CODE_SIGN_ENTITLEMENTS": "ios/HomeLine.entitlements",
          "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
          "LD_RUNPATH_SEARCH_PATHS": "$(inherited) @executable_path/Frameworks @loader_path/Frameworks",
          "SWIFT_OBJC_BRIDGING_HEADER": "ios/HomeLine-Bridging-Header.h",
          "PRODUCT_BUNDLE_IDENTIFIER": "org.example.homeline"
        }
      },
      "platform": "iOS",
      "info": {
        "path": "build/org.example.homeline.webrtc.plist",
        "properties": {
          "NSLocalNetworkUsageDescription": "\u8fde\u63a5\u540c\u4e00\u7f51\u7edc\u4e2d\u7684\u7535\u8bdd\u8bbe\u5907\uff0c\u6536\u53d1\u4fe1\u606f\u548c\u63a5\u6253\u7535\u8bdd\u3002",
          "NSMicrophoneUsageDescription": "\u4f7f\u7528\u9ea6\u514b\u98ce\u901a\u8fc7\u5bb6\u4e2d\u7684 SIM \u5361\u8fdb\u884c\u901a\u8bdd\u3002",
          "UILaunchScreen": {},
          "BGTaskSchedulerPermittedIdentifiers": [
            "org.example.homeline.inbox-refresh"
          ],
          "UISupportedInterfaceOrientations": [
            "UIInterfaceOrientationPortrait"
          ],
          "SMSBadgeKeychainGroup": "$(AppIdentifierPrefix)org.example.homeline.sms-badge",
          "NSContactsUsageDescription": "\u8bfb\u53d6\u4f60\u5141\u8bb8\u8bbf\u95ee\u7684\u8054\u7cfb\u4eba\uff0c\u7528\u968f\u884c\u7535\u8bdd\u62e8\u53f7\u6216\u53d1\u9001\u4fe1\u606f\u3002",
          "UIBackgroundModes": [
            "voip",
            "audio",
            "remote-notification",
            "fetch"
          ],
          "CFBundleShortVersionString": "$(MARKETING_VERSION)",
          "CFBundleVersion": "$(CURRENT_PROJECT_VERSION)",
          "CFBundleDisplayName": "\u968f\u884c\u7535\u8bdd"
        }
      }
    },
    "HomeLineTests": {
      "type": "bundle.unit-test",
      "settings": {
        "base": {
          "GENERATE_INFOPLIST_FILE": true
        }
      },
      "dependencies": [
        {
          "target": "HomeLine"
        }
      ],
      "platform": "iOS",
      "sources": [
        "ios/Tests"
      ]
    }
  },
  "packages": {
    "WebRTC": {
      "url": "https://github.com/stasel/WebRTC.git",
      "exactVersion": "156.0.0"
    }
  },
  "name": "HomeLineWebRTC",
  "options": {
    "deploymentTarget": {
      "iOS": "17.0"
    },
    "bundleIdPrefix": "org.example"
  },
  "settings": {
    "base": {
      "SWIFT_VERSION": "5.0",
      "TARGETED_DEVICE_FAMILY": "1",
      "CURRENT_PROJECT_VERSION": "62",
      "MARKETING_VERSION": "0.7.14",
      "SWIFT_ACTIVE_COMPILATION_CONDITIONS": "$(inherited) HOMELINE_WEBRTC_ONLY"
    },
    "configs": {
      "Debug": {
        "SWIFT_ACTIVE_COMPILATION_CONDITIONS": "$(inherited) DEBUG HOMELINE_WEBRTC_ONLY"
      }
    }
  },
  "schemes": {
    "HomeLine": {
      "build": {
        "targets": {
          "HomeLineTests": [
            "test"
          ],
          "HomeLine": "all"
        }
      },
      "test": {
        "environmentVariables": {
          "HOMELINE_TEST_MODE": "1"
        },
        "targets": [
          "HomeLineTests"
        ]
      }
    },
    "HomeLineNavigation": {
      "test": {
        "targets": [
          "HomeLineNavigationUITests"
        ]
      },
      "build": {
        "targets": {
          "HomeLineNavigationUITests": [
            "test"
          ],
          "HomeLine": "all"
        }
      }
    }
  }
}
