[Unit]
Description=HomeLine SakuraFrp HTTP and WebRTC gateway
Wants=network-online.target homeline-nas.service
After=network-online.target homeline-nas.service

[Service]
Type=exec
EnvironmentFile=/etc/homeline-nas/sakurafrp.env
ExecStart=/usr/bin/python3 /opt/homeline-nas/deploy/frp_gateway.py --http-bind 127.0.0.1:22443 --http-target ${FRP_HTTP_TARGET} --udp-bind 127.0.0.1:22444 --udp-target ${FRP_ICE_TARGET} --ice-origin ${FRP_ICE_TARGET} --public-udp ${FRP_PUBLIC_UDP}
Restart=always
RestartSec=5
DynamicUser=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
