HOMELINE_CONFIG=/etc/homeline-nas
HOMELINE_STATE=/var/lib/homeline-nas
AT_DEVICE=/dev/ttyUSB2
PCM_DEVICE=/dev/ttyUSB1
TLS_PORT=18443
ICE_PORT=20119
# For an optional public IPv4 relay, advertise its public address:
# ICE_PUBLIC_IP=203.0.113.10
# Bind ICE to the NAS WireGuard address when using its optional relay:
# ICE_BIND=10.70.0.2

# Set for the SakuraFrp managed TLS and UDP configuration:
# HOMELINE_MODE=sakurafrp
# FRP_ORIGIN_PORT=18086
